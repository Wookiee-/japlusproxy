# japm environment file. Copy to .env (gitignored) and edit.
# Real environment variables always win over these values.

# Server install root (GameData dir). Same as japm.conf [locations] ja_path.
#JAPLUS_HOME=/home/jka/openjk

# Run in foreground (no daemon fork). Same as JAPM_FG=1 prefix.
#JAPM_FG=1

# Proxy switches (same as instance proxy.no_hooks / proxy.no_oob).
#JAPLUS_NO_HOOKS=1
#JAPLUS_NO_OOB=1
