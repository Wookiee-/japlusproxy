// Server config generated from [instance_name] by japm
// DO NOT EDIT — changes will be overwritten

seta sv_hostname "[host_name]"
seta g_motd "[message_of_the_day]"

seta rconpassword "[rcon_password]"
seta g_password "[server_password]"

// Log watcher needs an active game log in the fs_game dir
seta logfile "1"
seta g_log "[log_name]"
seta g_logSync "1"

seta sv_fps "20"
seta sv_maxclients "[maxclients]"
seta sv_privateClients ""
seta sv_privatePassword ""
seta sv_maxRate "25000"
seta sv_maxPing "0"
seta sv_timeout "600"
seta sv_minSnaps "20"
seta sv_minRate "2000"
seta sv_floodProtect "1"

seta g_gametype "[gametype]"
seta timelimit "[timelimit]"
seta fraglimit "[fraglimit]"
seta duellimit "[duellimit]"
seta capturelimit "8"

seta g_allowVote "1"
seta g_allowNPC "0"
seta g_dismember "100"
seta g_filterban "1"
seta g_InactivityKick "0"
seta g_InactivitySpec "0"

[extra_cvars]

map [starting_map]
