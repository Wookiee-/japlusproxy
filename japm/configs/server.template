seta g_allowvote 1
seta timelimit "[timelimit]"
seta fraglimit "[fraglimit]"
seta capturelimit "[capturelimit]"
seta duel_fraglimit "[duel_fraglimit]"

seta g_autoMapCycle 1
seta sv_allowdownload 0

seta g_dismember "300" // the players must allow cg_dismember "300"

seta g_saberLocking 1
