// cvar set there OVERRIDES the defaults below.

////////////////////////////////////////////////////////////
///////////////////SERVER GENERAL SETTINGS//////////////////
////////////////////////////////////////////////////////////

//---------SERVER PASSWORDS-----------
seta rconpassword "[rcon_password]"
seta g_password "[server_password]"

//seta sv_privatePassword "pass for private clients"
//seta sv_privateClients 0

//----------MAIN SETTINGS------------
seta sv_hostname "[host_name]"
seta g_motd "[message_of_the_day]"
seta sv_maxclients "[maxclients]"

// gametypes
// 0 = FFA
// 3 = DUEL one on one tournament
// 4 = POWER DUEL
// 6 = TEAM DEATHMATCH
// 7 = SIEGE
// 8 = CTF
seta g_gametype "[gametype]"

seta sv_maxRate 25000
// rule of thumb: connection speed / (num clients x 8) = sv_maxrate

seta sv_master1 "master.jkhub.org"
seta sv_master2 "masterjk3.ravensoft.com"
seta sv_master3 ""
seta sv_master4 ""
seta sv_master5 ""

seta g_banIPs ""
seta sv_maxPing "0"
seta sv_floodProtect "1"
seta sv_reconnectlimit "10"
seta bot_minplayers 0

// Log watcher needs an active game log in the fs_game dir
seta logfile "1"
seta g_log "[log_name]"
seta g_logSync "1"

//---------FORCE & Weapons----------------
seta g_weaponDisable 524279  // just saber
seta g_forcePowerDisable 0 // For forcePower bit values use forcetoggle
seta g_maxForceRank 7
seta g_forceRegenTime "200" // 200 is the basejka default value.

//----------OTHER SERVER SETTINGS------
//seta g_gravity "800"
